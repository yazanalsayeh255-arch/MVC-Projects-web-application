@model CoffeeProject.Models.Cheese_Burger_Menu.RandomCheeseBurger

@{
    ViewBag.Title = "قائمة الطلبات";
}

<!-- Google Fonts (Cairo for crisp Arabic & English typography) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --bg-page: #f7f4f0;
        --bg-card: #ffffff;
        --primary-dark: #2c1e16; /* Rich Espresso */
        --primary-accent: #d97706; /* Warm Burger/Cheddar Amber */
        --primary-hover: #b45309;
        --text-main: #1f2937;
        --text-muted: #6b7280;
        --border-subtle: #e5e0d8;
        --row-hover: #fdf8f3;
        --danger-bg: #fee2e2;
        --danger-text: #dc2626;
        --edit-bg: #fef3c7;
        --edit-text: #b45309;
    }

    body {
        background-color: var(--bg-page);
        font-family: 'Cairo', sans-serif;
        color: var(--text-main);
    }

    .menu-dashboard-container {
        max-width: 1150px;
        margin: 40px auto;
        padding: 32px;
        background: var(--bg-card);
        border-radius: 20px;
        box-shadow: 0 12px 35px rgba(44, 30, 22, 0.08);
        border: 1px solid var(--border-subtle);
        direction: rtl;
        text-align: right;
    }

    /* Header Section */
    .menu-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        padding-bottom: 24px;
        margin-bottom: 24px;
        border-bottom: 2px solid var(--bg-page);
    }

    .menu-title-group h2 {
        margin: 0;
        font-size: 1.9rem;
        font-weight: 800;
        color: var(--primary-dark);
        letter-spacing: -0.3px;
    }

    .menu-title-group p {
        margin: 4px 0 0;
        color: var(--text-muted);
        font-size: 0.95rem;
    }

    /* Add New Button */
    .btn-add-order {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, var(--primary-accent), var(--primary-hover));
        color: #ffffff !important;
        text-decoration: none !important;
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.98rem;
        box-shadow: 0 6px 16px rgba(217, 119, 6, 0.28);
        transition: all 0.25s ease;
    }

        .btn-add-order:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(217, 119, 6, 0.38);
        }

    /* Responsive Table Wrapper */
    .table-responsive-wrapper {
        overflow-x: auto;
        border: 1px solid var(--border-subtle);
        border-radius: 14px;
    }

    /* Table Styling */
    table.bistro-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

        table.bistro-table thead th {
            background-color: var(--primary-dark);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.95rem;
            padding: 16px 18px;
            text-align: right;
            border: none;
        }

        table.bistro-table tbody td {
            padding: 15px 18px;
            border-bottom: 1px solid var(--border-subtle);
            vertical-align: middle;
            font-size: 0.96rem;
            color: var(--text-main);
        }

        table.bistro-table tbody tr:last-child td {
            border-bottom: none;
        }

        table.bistro-table tbody tr {
            background-color: #ffffff;
            transition: background-color 0.2s ease;
        }

            table.bistro-table tbody tr:hover {
                background-color: var(--row-hover);
            }

    /* Badges & Text Hierarchy */
    .price-badge {
        display: inline-block;
        background-color: #ecfdf5;
        color: #047857;
        font-weight: 800;
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 0.92rem;
    }

    .category-pill {
        display: inline-block;
        background-color: #f3efe9;
        color: var(--primary-dark);
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.88rem;
    }

    .item-name {
        font-weight: 700;
        color: var(--primary-dark);
    }

    /* Action Buttons */
    .action-group {
        display: inline-flex;
        gap: 8px;
        justify-content: center;
    }

    .btn-action {
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        text-decoration: none !important;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
    }

    .btn-edit {
        background-color: var(--edit-bg);
        color: var(--edit-text) !important;
    }

        .btn-edit:hover {
            background-color: #fde68a;
            transform: translateY(-1px);
        }

    .btn-delete {
        background-color: var(--danger-bg);
        color: var(--danger-text) !important;
    }

        .btn-delete:hover {
            background-color: #fecaca;
            transform: translateY(-1px);
        }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: var(--text-muted);
        font-weight: 600;
    }

    /* RTL Styling for Bootbox Modal */
    .bootbox .modal-content {
        font-family: 'Cairo', sans-serif;
        direction: rtl;
        text-align: right;
        border-radius: 16px;
        border: 1px solid var(--border-subtle);
    }

    .bootbox .modal-header {
        border-bottom: 1px solid var(--bg-page);
        flex-direction: row-reverse;
    }

    .bootbox .modal-footer {
        border-top: 1px solid var(--bg-page);
        justify-content: flex-start;
        gap: 8px;
    }
</style>

<div class="menu-dashboard-container">
    <div class="menu-header">
        <div class="menu-title-group">
            <h2>🍔 قائمة الطلبات</h2>
            <p>إدارة أصناف البرجر والوجبات والأسعار بكل سهولة</p>
        </div>

        @Html.ActionLink("＋ أضف طلبك الجديد هنا", "CreateList", null, new { @class = "btn-add-order" })
    </div>

    <div class="table-responsive-wrapper">
        <table class="table bistro-table" id="ordersTable">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.ADpages.price)</th>
                    <th>@Html.DisplayNameFor(model => model.ADpages.categoryOrder)</th>
                    <th>@Html.DisplayNameFor(model => model.ADpages.menuNames)</th>
                    <th>@Html.DisplayNameFor(model => model.ADpages.sizeOrder)</th>
                    <th style="text-align: center;">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ADpageslist != null && Model.ADpageslist.Any())
                {
                    foreach (var item in Model.ADpageslist)
                    {
                        <tr>
                            <td>
                                <span class="price-badge">
                                    @Html.DisplayFor(modelItem => item.price) JD
                                </span>
                            </td>
                            <td>
                                <span class="category-pill">
                                    @Html.DisplayFor(modelItem => item.categoryOrder.CategoryName)
                                </span>
                            </td>
                            <td>
                                <span class="item-name">
                                    @Html.DisplayFor(modelItem => item.menuNames.CheeseBurgerNames)
                                </span>
                            </td>
                            <td>
                                <span class="item-name">
                                    @Html.DisplayFor(modelItem => item.sizeOrder.Namesize)
                                </span>
                            </td>
                            <td style="text-align: center;">
                                <div class="action-group">
                                    @Html.ActionLink("تعديل", "EditList", new { id = item.Id }, new { @class = "btn-action btn-edit" })
                                    @Html.ActionLink("حذف", "DeleteBreakFast", new { id = item.Id }, new { @class = "btn-action btn-delete js-delete", data_item_name = item.menuNames.CheeseBurgerNames })
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="empty-state">
                            لا توجد طلبات مضافة حالياً. اضغط على "أضف طلبك الجديد هنا" للبدء.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <!-- Bootbox CDN (Remove this line if you already include bootbox in your BundleConfig) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootbox.js/5.5.2/bootbox.min.js"></script>

    <script>$(document).ready(function () {
            $('#ordersTable').on('click', '.js-delete', function (e) {
                e.preventDefault(); // Stop immediate navigation

                var deleteUrl = $(this).attr('href');
                var itemName = $(this).data('item-name') || 'هذا الصنف';

                bootbox.confirm({
                    title: "تأكيد الحذف",
                    message: "هل أنت متأكد أنك تريد حذف <strong>" + itemName + "</strong> من القائمة؟",
                    buttons: {
                        confirm: {
                            label: "نعم، احذف",
                            className: "btn-danger"
                        },
                        cancel: {
                            label: "إلغاء",
                            className: "btn-secondary"
                        }
                    },
                    callback: function (result) {
                        if (result) {
                            window.location.href = deleteUrl;
                        }
                    }
                });
            });
        });</script>
}